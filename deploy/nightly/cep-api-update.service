[Unit]
Description=Deploy tested CEP API updates at 02:00 Sao Paulo
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/cep-api
ExecStart=/usr/bin/flock -n /run/lock/cep-api-update.lock /usr/local/sbin/cep-api-nightly-deploy
TimeoutStartSec=45min
TimeoutStopSec=5min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Environment=GIT_TERMINAL_PROMPT=0
StandardOutput=journal
StandardError=journal
