server {
    listen 443 ssl;
    server_name ${API_DOMAIN};
    ssl_certificate /run/secrets/origin_certificate;
    ssl_certificate_key /run/secrets/origin_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 1m;

    include /etc/nginx/cloudflare-realip.conf;
    real_ip_header CF-Connecting-IP;

    location / {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        # Overwrite client-supplied forwarding headers with the trusted hop's values.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_hide_header X-Powered-By;
        add_header Cache-Control "no-store" always;
    }
}
